#include <stdio.h>
#include <string.h>

struct Produto{
    char nome[30];
    float preco;
    int quantidade;
};

int main(){

    struct Produto produto[20];

    int opcao;
    int totalProdutos = 0;
    int i;
    char procurar[30];
    int qtd;

    do{

        printf("\n========================\n");
        printf(" SISTEMA DA PADARIA\n");
        printf("========================\n");
        printf("1 - Cadastrar Produto\n");
        printf("2 - Vender Produto\n");
        printf("3 - Ver Produtos\n");
        printf("4 - Sair\n");
        printf("Escolha: ");
        scanf("%d",&opcao);

        if(opcao == 1){

            printf("\nNome do produto: ");
            scanf(" %[^\n]", produto[totalProdutos].nome);

            printf("Preco: ");
            scanf("%f",&produto[totalProdutos].preco);

            printf("Quantidade: ");
            scanf("%d",&produto[totalProdutos].quantidade);

            totalProdutos++;

            printf("\nProduto cadastrado com sucesso!\n");
        }

        else if(opcao == 2){

            if(totalProdutos == 0){
                printf("\nNao existe produto cadastrado.\n");
            }else{

                printf("\nDigite o nome do produto: ");
                scanf(" %[^\n]", procurar);

                int encontrou = 0;

                for(i = 0; i < totalProdutos; i++){

                    if(strcmp(procurar, produto[i].nome) == 0){

                        encontrou = 1;

                        printf("Quantidade que deseja comprar: ");
                        scanf("%d",&qtd);

                        if(qtd <= produto[i].quantidade){

                            produto[i].quantidade -= qtd;

                            printf("Total da compra: R$ %.2f\n", qtd * produto[i].preco);

                        }else{
                            printf("Estoque insuficiente.\n");
                        }

                        break;
                    }
                }

                if(encontrou == 0){
                    printf("Produto nao encontrado.\n");
                }
            }
        }

        else if(opcao == 3){

            if(totalProdutos == 0){

                printf("\nNenhum produto cadastrado.\n");

            }else{

                printf("\n------ PRODUTOS ------\n");

                for(i = 0; i < totalProdutos; i++){

                    printf("\nProduto %d\n", i + 1);
                    printf("Nome: %s\n", produto[i].nome);
                    printf("Preco: R$ %.2f\n", produto[i].preco);
                    printf("Quantidade: %d\n", produto[i].quantidade);

                }
            }
        }

        else if(opcao == 4){

            printf("\nObrigado por utilizar o sistema!\n");

        }

        else{

            printf("\nOpcao invalida!\n");

        }

    }while(opcao != 4);

    return 0;